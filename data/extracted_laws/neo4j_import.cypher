MERGE (n:Article {node_id: 'VN_BLLD_2019_D052'}) ON CREATE SET n.name = 'Điều 52: Cho thuê lai lao động', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '52', n.title = 'Cho thuê lai lao động', n.citation = 'Điều 52 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '52', n.content = 'Cho thuê lại lao động là việc nguời lao động giao kết hợp đồng lao động lao động được chuyển sang làm việc và chịu sự điều hành của sử dụng lao động khác mà vẫn duy trì quan hệ lao động với người sử d';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '52', n.content = 'Hoạt động cho thuê lại lao động là ngành; kinh doanh có điều kiện; chỉ được thực hiện bởi các doanh nghiệp có Giấy phép hoạt động cho thuê lại lao động và áp dụng đối với một số việc nhất định nghề\_';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '52', n.content = '2 Bên thuê lại lao động đuợc sử dụng lao động thuê lại trong trường hợp sau đây: - a) Đáp ứng tạm thời sự gia tăng đột ngột về nhu cầu sử dụng lao động trong khoảng thời gian nhất định; - b) thế lao đ';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '52', n.content = 'Bên thuê lại lao động không được sử dụng lao động thuê lại trong hợp sau đây: trường - c) Có nhu cầu sử dụng lao động trình độ chuyên môn, kỹ thuật cao.';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K09'}) ON CREATE SET n.name = 'Khoản 9 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '9', n.article_num = '52', n.content = 'Để thay thế người lao trong thời gian thực hiện quyền đình giải quyết tranh chấp lao động; động công;';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K10'}) ON CREATE SET n.name = 'Khoản 10 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '10', n.article_num = '52', n.content = 'Thay thế nguời lao động bị cho thôi việc do đổi cơ nghệ, vì lý do kinh tế hoặc chia, tách, hợp nhất, sáp nhập công thay - b) Không có thỏa thuận cụ thế về trách nhiệm bồi thường tai nạn lao động, bệnh';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D052_K12'}) ON CREATE SET n.name = 'Khoản 12 Điều 52 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '12', n.article_num = '52', n.content = '4 Bên thuê lại lao động được nguời lao động thuê lại cho sử dụng lao động khác; không được sử dụng lao động thuê lại được cung cấp bởi doanh nghiệp có Gíấy phép hoạt động cho thuê lại lao động chuyển';
