MERGE (n:Clause {node_id: 'VN_BLDS_2015_D002_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 2 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '2', n.content = '## nhận, tôn trọng, bảo vệ và bảo đảm quyền dân sự';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D002_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 2 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '2', n.content = '2 Quyền dân sự chỉ có thể bị hạn chế theo quy định của luật trong trường cần thiết vì lý do quốc phòng, an ninh quốc gia, trật tự, an toàn xã hội, đạo đức xã hội, sức khỏe của cộng đồng. hợp';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D003'}) ON CREATE SET n.name = 'Điều 3: Các tắc cơ bản của pháp luật dân sự nguyên', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '3', n.title = 'Các tắc cơ bản của pháp luật dân sự nguyên', n.citation = 'Điều 3 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D003_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 3 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '3', n.content = 'Cá nhân, pháp nhân xác lập, thực hiện, chấm dứt quyền, vụ dân sự của mình trên cơ sở tự tự nguyện cam kết, thỏa thuận. Mọi cam kết; thỏa thuận vi phạm điều cấm của luật, trái đạo đức xã hội có hiệu lự';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D003_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 3 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '3', n.content = '4 Việc xác lập, thực hiện, chấm dứt vụ dân sự được xâm phạm đến lợi ích quốc gia, dân tộc, lợi ích cộng, và lợi ích hợp pháp của khác. quyền; nghĩa không quyền công người - tự chịu trách nhiệm về việc';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D004'}) ON CREATE SET n.name = 'Điều 4: Áp dụng Bộ luật dân sự', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '4', n.title = 'Áp dụng Bộ luật dân sự', n.citation = 'Điều 4 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D004_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 4 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '4', n.content = 'Bộ luật này là luật chung điều chỉnh các quan hệ dân sự.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D004_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 4 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '4', n.content = 'Luật khác có liên quan điều chinh quan hệ dân sự trong các lĩnh vực cụ thể được trái với các nguyên tắc cơ bản của pháp luật dân sự quy định tại Điều 3 của Bộ luật này . không';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D004_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 4 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '4', n.content = 'Trường hợp luật khác có liên quan không quy định hoặc có quy định nhung vi phạm khoản 2 Điều này thì quy định của Bộ luật này đuợc áp dụng. - 4 Truờng hợp có sự khác nhau giữa quy định của Bộ luật này';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D005'}) ON CREATE SET n.name = 'Điều 5: Áp dụng tập quán', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '5', n.title = 'Áp dụng tập quán', n.citation = 'Điều 5 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D005_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 5 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '5', n.content = 'Tập là quy tắc xử sự có nội dung rõ để xác định quyền, nghĩa vụ của cá nhân; pháp nhân trong quan hệ dân sự cụ thể, được hình thành rộng rãi trong một vực dân sự. quán ràng vùng,';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D005_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 5 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '5', n.content = 'Truờng hợp các bên không có thoả thuận và pháp luật quy định thì có thể áp dụng tập nhưng tập áp dụng không được trái với các nguyên tắc cơ bản của pháp luật dân sự quy định tại Điều 3 của Bộ luật này';
