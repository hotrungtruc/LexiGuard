MERGE (n:Clause {node_id: 'VN_BLLD_2019_D125_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 125 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '125', n.content = 'Hình thức xử lý kỷ luật sa thải được sử dụng lao động áp dụng trong truờng hợp sau đây: người';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D125_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 125 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '125', n.content = 'Người lao động có hành vi tiết lộ bí mật kinh doanh, bí mật nghệ, xâm quyền sở hữu trí tuệ của nguời sử lao động, có hành vi gây thiệt hại ích của sử dụng lao động hoặc quấy rối tình dục tại nơi làm v';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D125_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 125 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '125', n.content = 'Nguời lao động bị xử lý kỷ luật kéo dài thời hạn luơng hoặc cách chức mà tái phạm trong thời gian chua xóa kỷ luật. Tái phạm là truờng hợp lao động lặp lai hành vi vi phạm đã bị xử lý kỷ luật mà chưa';
