MERGE (n:Article {node_id: 'VN_BLDS_2015_D048'}) ON CREATE SET n.name = 'Điều 48: Người giám bộ', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '48', n.title = 'Người giám bộ', n.citation = 'Điều 48 Bộ luật Dân sự 2015';
