MERGE (n:Clause {node_id: 'VN_BLDS_2015_D237_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 237 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '237', n.content = 'Chủ sở hữu từ bỏ quyền sở hữu của mình;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D237_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 237 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '237', n.content = 'Tài sản đã được tiêu dùng hoặc bị tiêu huỷ;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D237_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 237 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '237', n.content = 'Tài sản bị xử lý để thực hiện nghĩa vụ của chủ sở hữu;';
