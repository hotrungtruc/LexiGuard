MERGE (n:Clause {node_id: 'VN_BLDS_2015_D051_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 51 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '51', n.content = 'Ạgười giám sát việc giám hộ phải là nguời có năng lực hành vi dân sự đầy đủ nếu là cá nhân; có năng lực pháp luật dân sự phù hợp với việc giám sát nếu là pháp nhân; có điều kiện cần thiết để thực hiện';
