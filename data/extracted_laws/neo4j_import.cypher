MERGE (n:Clause {node_id: 'VN_BLLD_2019_D060_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 60 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '60', n.content = 'Nguời sử dụng lao động xây dựng kế hoạch năm và dành kinh cho việc đào bồi cao trình độ, kỹ nghề phát triển kỹ năng cho lao làm việc cho mình; đào tao cho người lao động trước khi chuyển làm khác cho';
