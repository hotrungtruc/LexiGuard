MERGE (n:Clause {node_id: 'VN_BLDS_2015_D148_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 148 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '148', n.content = 'Khi thời hạn tính năm thì thời hạn kết thúc tại thời điểm kết thúc bằng';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D148_K07'}) ON CREATE SET n.name = 'Khoản 7 Điều 148 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '7', n.article_num = '148', n.content = 'Khi ngày cuối của thời hạn là ngày nghỉ cuối tuần hoặc ngày lễ thì thời hạn kết thúc tại thời điểm kết thúc ngày làm việc tiếp theo ngày đó. cùng nghỉ nghỉ';
