MERGE (n:Clause {node_id: 'VN_BLDS_2015_D146_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 146 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '146', n.content = '- 1 một nửa tháng, tháng - Irường hợp các bên có thoả thuận về thời hạn là một năm; nửa năm; một tuần, một ngày; một giờ, một phút mà khoảng thời - gian diễn ra không liên nhau thì thời hạn đó đuợc tí';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D146_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 146 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '146', n.content = 'Truờng hợp các bên thoả thuận về thời điểm đầu giữa tháng; tháng; - a) Đầu là ngày đầu tiên của tháng tháng; - cuối thì thời đỉểm đó được quy định như sau: tháng - b) Giữa tháng là ngày thứ mười lăm c';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D146_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 146 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '146', n.content = 'năm thì thời điểm đó được quy định nhu sau: Truờng hợp - Cuối là ngày cuối cùng của tháng - a) Đầu năm là ngày đầu tiên của tháng một; - b) Giữa năm là ngày cuối của tháng sáu; cùng - của mười hai. -';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D148'}) ON CREATE SET n.name = 'Điều 148: Kết thúc thời hạn', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '148', n.title = 'Kết thúc thời hạn', n.citation = 'Điều 148 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D148_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 148 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '148', n.content = 'Khi thời hạn tính ngày thì thời hạn kết thúc tại thời điểm kết thúc ngày cuối cùng của thời hạn: bằng';
