MERGE (n:Law {node_id: 'VN_BLLD_2019'}) ON CREATE SET n.name = 'Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.title = 'Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019';
MERGE (n:Chapter {node_id: 'VN_BLLD_2019_CHI'}) ON CREATE SET n.name = 'Chương I: NHỮNG QUY ĐỊNH CHUNG', n.law_id = 'bo-luat-lao-dong-2019', n.chapter_num = 'I', n.title = 'NHỮNG QUY ĐỊNH CHUNG';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D001'}) ON CREATE SET n.name = 'Điều 1: Phạm vi điều chỉnh', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '1', n.title = 'Phạm vi điều chỉnh', n.citation = 'Điều 1 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D001_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 1 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '1', n.content = 'Bộ luật Lao động quy định tiêu chuẩn lao nhiệm của nguời lao động; sử dụng lao động chức đại diện lao động tại cơ sở, tổ chức đại diện người sử dụng lao trong quan hệ lao động và các quan hệ khác liên';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D001_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 1 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '1', n.content = '2 Người sử dụng lao động:';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D001_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 1 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '1', n.content = 'Nguời lao động nuớc làm việc tại Việt Nam. ngoài';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D003'}) ON CREATE SET n.name = 'Điều 3: Giải thích từ ngữ', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '3', n.title = 'Giải thích từ ngữ', n.citation = 'Điều 3 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '3', n.content = 'Trong Bộ luật này; các từ ngữ dưới đuợc hiểu nhu sau: đây - 1 Người lao là người làm việc cho nguời sử dụng lao động theo thỏa thuận, được trả lương và chịu sự lý, điều hành, giám sát của nguời sử dụn';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '3', n.content = 'Tổ chức đại diện người lao tại cơ sở là tổ chức thành lập trên cơ 8ở tự nguyện của nguời lao động tại một đơn vị sử lao nhằm mục đích bảo vệ quyền và lợi ích pháp, chính của lao trong quan hệ lao động';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '3', n.content = '4 là tổ chức đuợc thành lập hợp pháp, đại diện và bảo vệ quyền; lợi ích hợp pháp của người sử dụng lao trong hệ lao động động động quan';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '5', n.article_num = '3', n.content = 'Quan hệ lao là quan hệ xã hội phát sinh trong việc thuê mướn, sử dụng lao động, trả giữa người lao động, người sử dụng lao các tổ chức đại diện của các bên, cơ quan nhà nước có thẩm Quan hệ lao động b';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '6', n.article_num = '3', n.content = 'Người làm việc có quan hệ lao động là người làm việc trên cơ sở thuê mướn bằng hợp lao không không đồng động';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K07'}) ON CREATE SET n.name = 'Khoản 7 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '7', n.article_num = '3', n.content = 'Cưỡng bức lao là việc vũ lực, đe dọa dùng vũ lực hoặc các thủ khác để ép buộc lao động phải làm việc trái ý muốn của họ. động dùng đoạn người';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K08'}) ON CREATE SET n.name = 'Khoản 8 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '8', n.article_num = '3', n.content = 'Phân biệt đối xử trong lao là hành vi phân biệt; loại trù hoặc uu tiên dựa trên tộc, màu da, gốc quốc gia hoặc nguỗn xã hội, dân tộc; giới tính, độ tuổi, tình trang thai tình trang hôn nhân; tôn giáo,';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D003_K09'}) ON CREATE SET n.name = 'Khoản 9 Điều 3 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '9', n.article_num = '3', n.content = 'kỳ người nào đối với nguời khác tại nơi làm việc mà được đó mong muốn hoặc chấp nhận. Nơi làm việc là bất kỳ nơi nào mà nguời lao động thực tế làm việc theo thỏa thuận hoặc phân của người sử lao động:';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D004'}) ON CREATE SET n.name = 'Điều 4: Chính sách của Nhà nước về lao động', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '4', n.title = 'Chính sách của Nhà nước về lao động', n.citation = 'Điều 4 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D004_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 4 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '4', n.content = '- 1 Bảo đảm quyền và lợi ích hợp pháp, chính của nguời lao động, người làm việc có quan hệ lao động; khuyến khích thỏa thuận bảo đảm cho lao động có điều kiện thuận lợi hơn s0 với quy định của pháp lu';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D004_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 4 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '4', n.content = 'Tạo đỉều kiện thuận lợi đối với hoạt động tạo việc tự tạo việc và học ẩể có việc làm; hoạt động sản xuất; kinh doanh thu hút có quan hệ lao động: Jàm, làm, nghề nghề dạy . không';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D004_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 4 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '5', n.article_num = '4', n.content = 'Có chính sách phát triển thị truờng lao động; đa dạng các hình thức kết nối cung; cầu lao động:';
