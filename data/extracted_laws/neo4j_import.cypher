MERGE (n:Clause {node_id: 'VN_BLDS_2015_D166_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 166 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '166', n.content = 'Chủ sở hữu có đòi lại tài sản từ sự chiếm hữu của chủ thể có quyền khác đối với tài sản đó. quyền không đang';
