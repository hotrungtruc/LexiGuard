MERGE (n:Clause {node_id: 'VN_BLDS_2015_D221_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 221 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '221', n.content = 'Được thừa kế; <!-- image -->';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D221_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 221 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '6', n.article_num = '221', n.content = 'Chiếm hữu trong các điều kiện do pháp luật quy định đối với tài sản yô chủ, tài sản xác đinh chủ sở tài sản bị chôn, giấu, bị vùi lấp; chìm đắm được tìm thấy; tài sản do khác đánh rơi, bỏ quên; gia sú';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D221_K08'}) ON CREATE SET n.name = 'Khoản 8 Điều 221 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '8', n.article_num = '221', n.content = 'Truờng hợp khác do luật quy định.';
