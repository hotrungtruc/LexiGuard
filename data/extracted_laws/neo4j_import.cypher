MERGE (n:Clause {node_id: 'VN_BLLD_2019_D217_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 217 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '217', n.content = 'Nguời nào có hành vi vi phạm quy định của Bộ luật này thì tùy theo tính chất; mức độ vi mà bị xử Ỉý kỷ luật, xử phạt vi phạm hành chính hoặc bị truy cứu trách nhiệm hình sự, nếu gây thiệt hại thì bồi';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D217_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 217 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '217', n.content = 'Khi đã có quyết định của Tòa án về cuộc đình công là bất hợp pháp thì lao động tham gia đình phải ngùng ngay đình và trở lại làm việc; nếu nguời lao động không ngừng đình không trở lại làm việc thì ty';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D217_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 217 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '217', n.content = 'Người lợi dụng đình máy, thiết bị, tài sản của nguời sử dụng lao động; có hành vi cản trở thực hiện đình kích động, lôi kéo, ép buộc lao động đình có hành vi trù dập, trả thù tham gia đình lãnh đạo cu';
