MERGE (n:Clause {node_id: 'VN_BLDS_2015_D281_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 281 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '281', n.content = '- 1 Nghĩa vụ thực hiện một việc là nghĩa vụ mà theo đó bên có vụ thực hiện việc đó. phải công nghĩa phải đúng công';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D281_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 281 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '281', n.content = 'Nghĩa vụ không được thực hiện một công việc là nghĩa vụ mà theo đó bên có vụ không được thực hiện việc đó. nghĩa công <!-- image -->';
