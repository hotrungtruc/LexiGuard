MERGE (n:Article {node_id: 'VN_BLLD_2019_D061'}) ON CREATE SET n.name = 'Điều 61: Học tập để làm việc cho sử dụng lao nghề, nghề người động', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '61', n.title = 'Học tập để làm việc cho sử dụng lao nghề, nghề người động', n.citation = 'Điều 61 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D061_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 61 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '61', n.content = 'Học để làm việc cho người sử dụng lao động là việc sử lao động tuyển người vào để đào tạo nghiệp tại nơi làm việc. Thời gian học theo chương trình đào tao của trình độ theo quy định của Luật Giáo dục';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D061_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 61 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '61', n.content = 'Tập để làm việc cho người sử dụng lao động là việc người sử dụng lao động tuyển người vào để dẫn thực hành việc, tập làm theo vịtrí việc làm tại nơi làm việc. Thời hạn tập quá 03 nghề hướng nghề công';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D061_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 61 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '61', n.content = '3 Người sử dụng lao động tuyển người vào học nghề tập để làm việc cho mình thì phải ký hoạt dục nghiệp; không thu học phí; phải ký hợp đào tao theo quy định của Luật Giáo dục nghiệp. nghề không đăng đ';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D061_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 61 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '61', n.content = 'Người học nguời tập phải đủ 14 tuổi trở lên và phải có đủ sức khỏe phù với yêu cầu học nghề, tập Người học nguời tập thuộc danh mục nghề, việc nặng nhọc, độc hại, nguy hiểm hoặc đặc biệt hội ban hành';
