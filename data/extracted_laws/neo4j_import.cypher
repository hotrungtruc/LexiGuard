MERGE (n:Clause {node_id: 'VN_BLDS_2015_D288_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 288 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '288', n.content = '2 Bên có nghĩa vụ có thể thực hiện nghĩa vụ của mình đối với bất cứ ai trong số nguời có quyền liên đới. những';
