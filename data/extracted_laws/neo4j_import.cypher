MERGE (n:Clause {node_id: 'VN_BLLD_2019_D077_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 77 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '77', n.content = 'Trong thời hạn 10 ngày kể từ ngày thỏa ước lao động tập thể được ký kết, nguời sử dụng lao động tham gia thỏa ước gửị 01 bản thỏa ước lao động tập thể đến cơ quan chuyên môn về lao động thuộc Ủy ban n';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D077_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 77 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '77', n.content = 'Thỏa ước lao tập thế doanh nghiệp có hiệu lực áp dụng đối với sử dung lao động và toàn bộ nguời lao động của doanh nghiệp. Thỏa ước lao tập thể ngành và thỏa ước lao động tập thể có nhiều doanh nghiệp';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D077_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 77 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '77', n.content = 'Khi một bên cho bên kia thực hiện đầy đủ hoặc vi phạm thỏa uớc lao tập thể thì có quyền yêu cẩu thi hành thỏa ước lao tập thể và các bên có trách nhiệm xem xét giải quyết; nếu mỗi bên đều có quyền yêu';
