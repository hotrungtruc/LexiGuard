MERGE (n:Clause {node_id: 'VN_BLDS_2015_D279_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 279 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '279', n.content = 'Bên có vụ giao vật phải bảo quản; giữ gìn vật cho đến khi giao. nghĩa';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D279_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 279 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '279', n.content = 'Khi vật giao là vật đặc định thì bên có nghĩa vụ phải giao vật đó và đúng tình trang như đã cam kết; nếu là vật cùng loại thì phải giao số có thoả thuận về chất thì phải giao vật đó với chất lượng tru';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D279_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 279 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '279', n.content = 'Bên có nghĩa vụ phải chịu mọi chi phí về việc giao vật; trù truờng hợp có thoả thuận khác. ## Đỉều 280. Thực hỉện nghĩa vụ trả tiền - 1 Nghĩa vụ trả tiền phải được thực hiện đầy đủ, đúng thời hạn; đún';
