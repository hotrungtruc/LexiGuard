MERGE (n:Clause {node_id: 'VN_BLDS_2015_D019_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 19 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '19', n.content = 'Người thành niên có quy định tại các điều 22, 23 và 24 của Bộ luật này . năng hợp ## Đỉều 21. Người chưa thành niên - 1 Người chua thành niên là người chua đủ mười tám tuổi.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D019_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 19 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '19', n.content = 'Người từ đủ sáu tuổi đến chua đủ mười lăm tuổi khi xác lập, thực hiện ý, trừ giao dịch - giao dịch dân sự phải được người đại diện theo pháp luật dân sự phục vụ nhu cầu sinh hoạt ngày hợp với lứa hàng';
