MERGE (n:Clause {node_id: 'VN_BLDS_2015_D285_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 285 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '285', n.content = 'Bên có nghĩa vụ phải thông báo cho bên có quyền biết về việc tài sản hoặc việc được lựa chon để thực hiện nghĩa vụ. Truờng hợp bên có quyền đã xác định thời hạn thực hiện nghĩa vụ được lựa chọn thì bê';
