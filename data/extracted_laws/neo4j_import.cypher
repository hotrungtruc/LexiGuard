MERGE (n:Article {node_id: 'VN_BLDS_2015_D284'}) ON CREATE SET n.name = 'Điều 284: Thực hiện nghĩa vụ có điều kiện', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '284', n.title = 'Thực hiện nghĩa vụ có điều kiện', n.citation = 'Điều 284 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D284_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 284 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '284', n.content = 'Khi được bên có ý, bên có nghĩa vụ có thể uỷ quyền cho thứ ba mình thực hiện nghĩa vụ nhưng vẫn phải chịu trách nhiệm với bên có nếu thứ ba không thực hiện hoặc thực hiện không đúng nghĩa vụ. quyền đồ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D284_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 284 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '284', n.content = 'Trường hợp điều kiện xảy ra hoặc xảy ra do có sự tác động của một bên thì áp dụng quy định tại khoản 2 Điều 120 của Bộ luật này. không';
