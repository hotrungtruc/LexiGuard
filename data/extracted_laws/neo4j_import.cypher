MERGE (n:Article {node_id: 'VN_BLDS_2015_D221'}) ON CREATE SET n.name = 'Điều 221: Căn cứ xác lập quyền sở hữu', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '221', n.title = 'Căn cứ xác lập quyền sở hữu', n.citation = 'Điều 221 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D221_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 221 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '221', n.content = 'Quyền sở hữu đuợc xác lập đối với tài sản trong trường hợp sau đây: - 1 Do lao do hoat sản xuất; kinh doanh hợp pháp, d động tạo ra đối tuợng quyền sở hữu trí tuệ; động, động hoạt sáng - định của Tòa';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D221_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 221 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '221', n.content = 'Được chuyển quyền sở hữu theo thoả thuận hoặc theo bản quyết';
