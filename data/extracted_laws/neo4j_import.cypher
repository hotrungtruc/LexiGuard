MERGE (n:Article {node_id: 'VN_BLLD_2019_D095'}) ON CREATE SET n.name = 'Điều 95: Trả Iương', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '95', n.title = 'Trả Iương', n.citation = 'Điều 95 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D095_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 95 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '95', n.content = 'Tiền ghi trong hợp lao và tiền trả cho người lao động tiền Việt Nam; hợp ao nước tại Việt Nam thì có thể ngoai tệ. đồng lương động lương Đồng trường người động nguời ngoài bằng';
