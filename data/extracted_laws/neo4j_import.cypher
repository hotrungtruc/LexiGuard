MERGE (n:Clause {node_id: 'VN_BLLD_2019_D091_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 91 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '91', n.content = '4 Irường vì lý do bất khả mà sử lao động đã tìm mọi biện pháp khắc phục nhung không thể trả lương hạn thì được chậm 30 ngày; nếu trả chậm từ 15 ngày trở lên thì lao đền bù cho lao động một khoản tiền';
