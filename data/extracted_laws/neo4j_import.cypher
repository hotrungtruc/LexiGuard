MERGE (n:Clause {node_id: 'VN_BLDS_2015_D022_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 22 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '22', n.content = 'Giao dịch dân sự của người mất lực hành vi dân sự phải do người đại diện theo pháp luật xác lập, thực hiện.';
