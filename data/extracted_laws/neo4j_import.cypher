MERGE (n:Clause {node_id: 'VN_BLLD_2019_D098_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 98 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '98', n.content = '2 Nguời lao động làm việc vào ban đêm thì được trả thêm ít nhất 30% tiền tính theo đơn giá tiền luơng hoặc tiền lương thực trả theo công việc của ngày làm việc bình thường. bẳng luong';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D098_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 98 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '5', n.article_num = '98', n.content = 'Vào ngày nghỉ lễ, tết, ngày nghỉ có hưởng lương, ít nhất 300% chua kể tiền luơng ngày lễ tết, ngày nghỉ có luơng đối với lao động huởng lương ngày. bằng nguời huởng';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D098_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 98 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '6', n.article_num = '98', n.content = '3 . Nguời lao động làm thêm giờ vào ban đêm thì việc trả lương theo quy định tại khoản 1 và khoản 2 Điều này; lao động còn được trả thêm 20% tiền tính theo đơn giá tiền hoặc tiền theo việc làm vào ban';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D099'}) ON CREATE SET n.name = 'Điều 99: Tiền Iương ngừng việc', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '99', n.title = 'Tiền Iương ngừng việc', n.citation = 'Điều 99 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D099_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 99 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '99', n.content = 'Trường hợp phải ngừng việc; lao động được trả như sau: nguời - 1 Nếu do lỗi của người sử dụng lao động thì người lao động được trả đủ tiền theo lao động; đồng lương hợp - 2 Nếu do lỗi của người lao độ';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D099_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 99 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '99', n.content = 'Nếu vì sụ cố về điện; nước mà do lỗi của người sử dụng lao động theo yêu cầu của cơ quan nhà nước có thẩm hoặc vì lý do kinh tế thì hai bên thỏa thuận về tiền ngừng việc như sau: không động quyền luơn';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D100'}) ON CREATE SET n.name = 'Điều 100: Trả qua cai thầu lương thông người', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '100', n.title = 'Trả qua cai thầu lương thông người', n.citation = 'Điều 100 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D100_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 100 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '100', n.content = 'Nơi nào sử dụng cai thầu hoặc người có vai trò trung gian tuơng tự thì người sử dụng lao động là chủ chính này kèm theo danh sách lao động làm việc với họ và phải bảo đảm việc họ tuân thủ quy định của';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D100_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 100 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '100', n.content = 'Truờng hợp cai thầu hoặc người có vai trò gian tương tự trả hoặc trả đầy đủ và bảo đảm các quyền Iợi khác cho nguời lao động thì người sử lao động là chủ chính phải chịu trách nhiệm trả và bảo đảm các';
