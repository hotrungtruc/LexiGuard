MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '7', n.content = '- 1 Việc xác lập, thuc hiện, chấm dứt quyền; nghĩa vụ dân sự phải bảo đảm gìn bản sắc dân tộc, tôn trong và phát phong tục, tập quán, truyền tốt cộng Vì mỗi nguời và các trị đạo đức cao của các dân tộ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '7', n.content = 'Trong quan hệ dân sụ, việc hoà giải giữa các bên hợp với quy định của pháp luật được khích. phù khuyến ## dân sự quyền Quyền dân sự được xác lập từ các căn cứ sau đây:';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '7', n.content = 'Quyết định của Tòa cơ quan có thẩm quyền khác theo quy định án,';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '7', n.content = '3 của luật;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '7', n.content = '4, Kết quả của lao động, sản xuất, kinh doanh; kết quả của hoạt động tao ra đối tượng quyền sở hữu trí tuệ; sáng';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D007_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 7 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '6', n.article_num = '7', n.content = 'Sử dụng tài sản, được lợi về tài sản không có căn cứ pháp luật;';
