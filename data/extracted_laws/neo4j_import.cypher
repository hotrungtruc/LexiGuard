MERGE (n:Clause {node_id: 'VN_BLLD_2019_D062_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 62 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '62', n.content = 'Hợp \'đồng đào tạo nghề phải có các nội dung chủ yếu sau đây: - a) đào tao; - b) Địa điểm, thời gian và tiền trong thời gian đào tạo; lương - c) Thời hạn cam kết phải làm việc sau khi được đào tao;';
