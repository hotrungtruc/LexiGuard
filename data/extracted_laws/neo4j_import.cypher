MERGE (n:Clause {node_id: 'VN_BLLD_2019_D123_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 123 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '123', n.content = 'Nguời sử dụng lao phải ban hành quyết định xử lý kỷ luật lao động trong thời hạn quy định tại khoản 1 và khoản 2 Điều này. động';
