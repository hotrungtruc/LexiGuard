MERGE (n:Clause {node_id: 'VN_BLDS_2015_D029_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 29 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '29', n.content = 'Cá nhân có quyền xác định, xác định lại dân tộc của mình';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D029_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 29 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '29', n.content = 'Cá nhân khi sinh ra được xác định dân tộc theo dân tộc của cha đẻ, mẹ đẻ. Trường cha đẻ, mẹ đẻ thuộc hai dân tộc khác nhau thì dân tộc của con đuợc xác định theo dân tộc của cha đẻ hoặc mẹ đẻ theo tho';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D029_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 29 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '29', n.content = 'Cá nhân có quyền yêu cầu co quan nhà nước có thẩm quyền xác định lại dân tộc trong truờng hợp sau đây: - a) Xác định lại theo dân tộc của cha đẻ hoặc mẹ đẻ trong trường hợp cha đẻ, mẹ đẻ thuộc hai dân';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D029_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 29 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '29', n.content = '4; Việc xác định lại dân tộc cho nguời từ đủ mười lăm tuổi đến dưới mười tám tuổi được sự ý của người đó. phải';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D029_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 29 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '29', n.content = 'Cấm lợi dụng việc xác định lại dân tộc nhằm mục đích trục lợi hoặc gây chia rẽ, phuơng hại đến sự đoàn kết của các dân tộc Việt Nam.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D030'}) ON CREATE SET n.name = 'Điều 30: Quyền được khai sinh, khai tử', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '30', n.title = 'Quyền được khai sinh, khai tử', n.citation = 'Điều 30 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D030_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 30 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '30', n.content = 'Cá nhân từ khi sinh ra có quyền được khai sinh. - 2 Cá nhân chết phải được khai tử.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D030_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 30 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '30', n.content = 'Trẻ em sinh ra mà sống được từ hai mưvi bốn giờ trở lên mới chết thì phải được khai sinh và khai tử; nếu sinh ra mà dưới hai mươi bốn giờ thì không khai sinh và khai tử, trừ truờng hợp cha đẻ, mẹ đẻ c';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D031'}) ON CREATE SET n.name = 'Điều 31: Quyền đối với tịch quốc', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '31', n.title = 'Quyền đối với tịch quốc', n.citation = 'Điều 31 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D031_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 31 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '31', n.content = 'Cá nhân có quyền có quốc tịch. - Việc xác định, đổi, nhập; thôi, trở lai tich Việt Nam do Luật tịch Việt Nam quy định. quốc thay quốc';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D031_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 31 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '31', n.content = 'Quyền của nguời tịch cu trú, sinh trên lãnh thổ Việt quốc sống không';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D032'}) ON CREATE SET n.name = 'Điều 32: Quyền của cá nhân đối với hình ảnh', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '32', n.title = 'Quyền của cá nhân đối với hình ảnh', n.citation = 'Điều 32 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D032_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 32 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '32', n.content = 'Cá nhân có quyền đối với hình ảnh của mình. Việc sử dụng hình ảnh của cá nhân phải được nguời đó đồng ý. Việc sử dụng hình ảnh của nguời khác vì mục đích thuơng mại thì phải trả thù lao cho có hình ản';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D032_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 32 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '32', n.content = 'Việc sử dụng hình ảnh trong truờng sau đây không cần có sự của có hình ảnh hoặc người đại diện theo pháp luật của họ: hợp người';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D032_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 32 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '32', n.content = 'hình ảnh có yêu cầu Tòa án ra quyết định buộc người vi phạm, cơ quan; tổ chức, cá nhân có liên quan phải thu hồi, tiêu chấm dứt việc sử dụng hình ảnh, bồi thường thiệt hại và áp dụng các biện pháp xử';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D032_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 32 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '32', n.content = 'Việc gây mê, mổ, cắt bỏ, cấy ghép mô, bộ phận cơ thế người; thực hiện kỹ thuật; phương pháp khám; chữa bệnh mới trên co thể người; thử nghiệm y học, dược học, khoa học bất cứ hình thức thử nghiệm nào';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D034'}) ON CREATE SET n.name = 'Điều 34: Quyền được bảo vệ danh dự, nhân phẩm, uy tín', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '34', n.title = 'Quyền được bảo vệ danh dự, nhân phẩm, uy tín', n.citation = 'Điều 34 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D034_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 34 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '34', n.content = 'Cá nhân có quyền yêu cầu Tòa án bác bỏ tin làm ảnh hưởng xấu đến danh dự, nhân phẩm, uy tín của mình. thông Việc bảo vệ danh dự, nhân phẩm, uy tín có thể được thực hiện sau khi cá nhân chết theo yêu c';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D034_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 34 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '34', n.content = 'Cá nhân bị tin làm ảnh hưởng xấu đến danh dự, nhân phẩm; uy tín thì ngoài quyền yêu cầu bác bỏ thông tin đó còn có quyền yêu cầu đua ra tin xin lỗi, cải chính khai và bồi thường thiệt hại. thông người';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D035'}) ON CREATE SET n.name = 'Điều 35: Quyền biến, nhận mô, bộ phận cơ thể ngưòi và biến, lấy xác', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '35', n.title = 'Quyền biến, nhận mô, bộ phận cơ thể ngưòi và biến, lấy xác', n.citation = 'Điều 35 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D035_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 35 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '35', n.content = '- 1 Cá nhân có quyền hiến mô, bộ phận cơ thể của mình khi còn hoặc hiến mô, bộ phận cơ thể, hiến xác của mình sau khi chết vì muc đích chữa bệnh cho người khác hoặc nghiên cứu y học, dược học và các n';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D035_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 35 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '35', n.content = 'Việc hiến, lấy mô, bộ phận cơ thể nguời, hiến, lấy xác phải tuân thủ theo các điều kiện và được thực hiện theo quy định của Bộ luật này; Luật hiến; lấy ghép mô, bộ phận cơ thể người và hiến, lấy xác v';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D036'}) ON CREATE SET n.name = 'Điều 36: Quyền xác định lại giới tínb', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '36', n.title = 'Quyền xác định lại giới tínb', n.citation = 'Điều 36 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D036_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 36 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '36', n.content = 'Cá nhân có quyền xác định lại giới tính. Việc xác định lại tính của một người được thực hiện trong trường hợp giới tính của đó bị khuyết tật bẩm sinh hoặc chưa định hình chính xác mà cần có sự can thi';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D036_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 36 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '36', n.content = 'Việc xác định lại giới tính được thực hiện theo quy định của pháp luật.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D037'}) ON CREATE SET n.name = 'Điều 37: Chuyển đỗi giới tính', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '37', n.title = 'Chuyển đỗi giới tính', n.citation = 'Điều 37 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D037_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 37 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '37', n.content = 'Việc đổi giới tính được thực hiện theo quy định của luật: Cá nhân đã chuyển đổi tính có quyền; nghĩa vụ ký đổi hộ tịch theo quy định của pháp luật về hộ tịch; có quyên nhân thân phù với giới tính đã đ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D037_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 37 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '37', n.content = 'Các bên trong hợp đồng không đuợc tiết lộ thông tin về đời riêng bí mật cá nhân, bí mật gia đình của nhau mà mình đã biết được trong trình xác lập, thực hiện hợp trừ trường hợp có thỏa thuận khác. sốn';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D037_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 37 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '37', n.content = 'của vỢ chồng, quyền xác định cha, mẹ quyền được nhận làm con nuôi, nuôi con hệ cha mẹ và quyền con, quan';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D039'}) ON CREATE SET n.name = 'Điều 39: Quyền nhân thân trong hôn nhân và gia đình', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '39', n.title = 'Quyền nhân thân trong hôn nhân và gia đình', n.citation = 'Điều 39 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D039_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 39 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '39', n.content = 'Con sinh ra không phụ thuộc vào tình trạng hôn nhân của cha, mẹ đều có quyền và nghĩa vụ nhu nhau đối với cha, mẹ của mình.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D039_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 39 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '39', n.content = '2 Cá nhân thực hiện quyền nhân thân trong hôn nhân và gia đình theo quy định của Bộ luật này; Luật hôn nhân và gia đình và luật khác có liên quan.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D040'}) ON CREATE SET n.name = 'Điều 40: Nơi cư trú của cá nhân', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '40', n.title = 'Nơi cư trú của cá nhân', n.citation = 'Điều 40 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D040_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 40 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '40', n.content = 'Nơi cư trú của cá nhân là nơi người đó thường xuyên sinh sống.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D040_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 40 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '40', n.content = 'Trường hợp không xác định được nơi cư trú của cá nhân theo định';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D040_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 40 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '40', n.content = 'tại khoản 1 Điều này thì nơi cu trú của cá nhân là nơi nguời đó đang sinh';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D040_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 40 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '40', n.content = '3 Trường một bên trong quan hệ dân sự thay đổi nơi cu trú gắn với việc thực hiện quyên, nghĩa vụ thì phải báo cho bên kia biết về nơi cư trú mới. hợp thông';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D041'}) ON CREATE SET n.name = 'Điều 41: Nơi cư trú của ngưòi chưa thành niên', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '41', n.title = 'Nơi cư trú của ngưòi chưa thành niên', n.citation = 'Điều 41 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D041_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 41 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '41', n.content = 'Nơi cư trú của chua thành niên là nơi cu trú của cha, mẹ; nếu mẹ có nơi cư trú khác nhau thì nơi cư trú của người cha, người';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D041_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 41 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '41', n.content = 'chưa thành niên là nơi cu trú của cha hoặc mẹ mà nguời chua thành niên thường xuyên chung sống.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D041_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 41 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '41', n.content = '2 Nguời chưa thành niên có thể có nơi cư trú khác với nơi cư trú của mẹ nếu được cha; mẹ đồng ý hoặc pháp luật có quy định. cha,';
