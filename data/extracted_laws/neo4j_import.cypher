MERGE (n:Clause {node_id: 'VN_BLDS_2015_D321_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 321 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '321', n.content = 'Được bán, trao đổi, tặng cho tài sản thế chấp không phải là hàng hóa luân trong trình sản xuất, kinh doanh, nếu được bên nhận thế chấp hoặc theo quy định của luật. chuyển quá đồng';
