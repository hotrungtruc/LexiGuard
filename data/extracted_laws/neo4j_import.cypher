MERGE (n:Article {node_id: 'VN_BLDS_2015_D224'}) ON CREATE SET n.name = 'Điều 224: Xác lập quyền sở hữu đối với hoa lợi, lợi tức', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '224', n.title = 'Xác lập quyền sở hữu đối với hoa lợi, lợi tức', n.citation = 'Điều 224 Bộ luật Dân sự 2015';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D225'}) ON CREATE SET n.name = 'Điều 225: Xác lập quyền sở hữu trong trường hợp sáp nhập', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '225', n.title = 'Xác lập quyền sở hữu trong trường hợp sáp nhập', n.citation = 'Điều 225 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D225_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 225 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '225', n.content = '- Trường hợp tài sản của nhiều chủ sở hữu khác nhau được sáp nhập với nhau tạo thành vật không chia được và thể xác dịnh tài sản đem sáp nhập là vật chính hoặc vật phụ thì vật mới được tạo thành là tà';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D225_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 225 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '225', n.content = 'Khi một người sáp nhập tài sản là động sản của khác vào tài sản là động sản của mình, mặc dù đã biết hoặc phải biết tài sản đó phải là của mình và cũng được sự Ý của chủ sở hữu tài sản bị sáp nhập thì';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D225_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 225 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '225', n.content = 'Khi một người sáp nhập tài sản là động sản của khác vào tài sản là bất sản của mình, mặc dù đã biết hoặc phải biết tài sản đó phải là của mình và cũng được sự ý của chủ sở hữu tài sản bị sáp nhập thì';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D225_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 225 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '225', n.content = 'Khi một nguời sáp nhập tài sản là sản của mình vào một bất động sản của nguời khác thì chủ sở hữu bất sản có quyền yêu cầu người sáp nhập dỡ bỏ tài sản sáp nhập trái phép và bồi thiệt hại hoặc giữ lại';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D226'}) ON CREATE SET n.name = 'Điều 226: Xác lập sở hữu trong trường hợp trộn lẫn quyền', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '226', n.title = 'Xác lập sở hữu trong trường hợp trộn lẫn quyền', n.citation = 'Điều 226 Bộ luật Dân sự 2015';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D227'}) ON CREATE SET n.name = 'Điều 227: Xác lập sở hữu trong trường hợp chế biến quyền', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '227', n.title = 'Xác lập sở hữu trong trường hợp chế biến quyền', n.citation = 'Điều 227 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D227_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 227 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '227', n.content = 'Chủ sở hũu của nguyên vật liệu được đem chế biến tạo thành vật mới là chủ sở hữu của vật mới được tạo thành.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D227_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 227 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '227', n.content = 'Nguời nguyên vật liệu thuộc sở hữu của nguời khác để chế biến mà ngay tình thì trở thành chủ sở hũu của tài sản mới nhung phải thanh toán giá trị nguyên vật liệu, bồi thường thiệt hại cho chú sở hữu n';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D227_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 227 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '227', n.content = '3 Trựờng chế biến ngay tình thì chủ sở hữu nguyên vật liệu có quyền yêu cẩu giao lại vật mới; nếu có nhiều chủ sở hữu nguyên vật liệu thì những này là chủ sở hữu theo đối với vật mới được tạo thành, t';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D230'}) ON CREATE SET n.name = 'Điều 230: Xác lập sở hữu đối với tài sản do khác đánh rơi, bỏ quên quyền người', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '230', n.title = 'Xác lập sở hữu đối với tài sản do khác đánh rơi, bỏ quên quyền người', n.citation = 'Điều 230 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D230_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 230 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '230', n.content = '- 1 Người phát hiện tài sản do nguời khác đánh rơi; bỏ quên mà biết được địa chỉ của người đánh rơi hoặc bỏ quên thì phải thông báo hoặc trả lại tài sản cho đó; nếu không biết địa chỉ của nguời đánh r';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D230_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 230 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '230', n.content = 'Sau 01 năm, kể từ ngày thông báo công khai về tài sản do khác đánh rơi, bỏ quên mà không, xác định được chủ sở hữu hoặc chủ sở hữu đến nhận thì quyền sở hữu đối với tài sản này được xác định như sau:';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D230_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 230 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '230', n.content = '1 Người bắt được gia súc bị thất lạc phải nuôi giữ và báo ngay cho Uỷ ban nhân dân cấp xã nơi nguời đó cu trú để báo khai cho chủ sở hữu biết mà nhận lại. Sau 06 báo khai hoặc sau 01 năm đối với gia s';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D230_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 230 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '230', n.content = '2 Trường hợp chủ sở hữu được nhận lại gia súc bị,thất lạc thì thanh toán tiền nuôi giữ và các chi phí khác cho bắt được gia súc; thời gian nuôi giữ gia súc bị thất lạc, nếu gia súc có sinh con thì ngư';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D232'}) ON CREATE SET n.name = 'Điều 232: Xác lập quyền sở hữu đối với gia cầm bị thất lạc', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '232', n.title = 'Xác lập quyền sở hữu đối với gia cầm bị thất lạc', n.citation = 'Điều 232 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D232_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 232 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '232', n.content = '- 1 Trường hợp gia cầm của một người bị thất lạc mà nguời khác bắt được thì nguời bắt được phài báo công khai để chủ sở hũu gia cầm biết mà nhận lại. Sau 01 tháng, kể từ ngày thông báo khai mà không c';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D232_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 232 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '232', n.content = 'Truờng chủ sở hữu được nhận lại gia cầm bị thất lạc thì phải thanh toán tiền công nuôi giữ và chi phí khác cho nguời bắt được gia cầm. Trong thời gian nuôi giữ gia cầm bị thất lạc, bắt được gia cầm đư';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D233'}) ON CREATE SET n.name = 'Điều 233: Xác lập sở hữu đối với vật nuôi dưới nước quyền', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '233', n.title = 'Xác lập sở hữu đối với vật nuôi dưới nước quyền', n.citation = 'Điều 233 Bộ luật Dân sự 2015';
