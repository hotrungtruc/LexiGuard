MERGE (n:Clause {node_id: 'VN_BLDS_2015_D160_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 160 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '160', n.content = 'Quyền sở quyền khác đối với tài sản được xác lập; thực hiện trong truờng hợp Bộ luật này, luật khác có liên quan quy định. hữu, Quyền khác đối với tài sản vẫn có hiệu lực trong trường hợp quyền sở hũu';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D160_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 160 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '160', n.content = 'Chủ sở hữu được thực hiện mọi hành vi theo ý chí của mình đối với tài sản nhung được trái với quy định của luật, gây thiệt hại hoặc làm ảnh huởng đến lợi ích quốc gia, dân tộc, Ỉợi ích công cộng, quyề';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D162'}) ON CREATE SET n.name = 'Điều 162: Chịu rủi ro về tài sản', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '162', n.title = 'Chịu rủi ro về tài sản', n.citation = 'Điều 162 Bộ luật Dân sự 2015';
