MERGE (n:Clause {node_id: 'VN_BLDS_2015_D131_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 131 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '131', n.content = 'Bên có lỗi gây thiệt hại thì phải bồi thường. - 5 của giao dịch dân sự vô hiệu liên quan đến nhân thân do Bộ luật này, luật khác có liên quan quy định. quả quyền';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D132'}) ON CREATE SET n.name = 'Điều 132: Thời hiệu yêu cầu Tòa án tuyên bố giao dịch dân sự vô hiệu', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '132', n.title = 'Thời hiệu yêu cầu Tòa án tuyên bố giao dịch dân sự vô hiệu', n.citation = 'Điều 132 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D132_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 132 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '132', n.content = 'Thời hiệu yêu cầu Tòa án tuyên bố giao dịch dân sự vô hiệu quy định tại các điều 125,126, 127, 128 và 129 của Bộ luật này là 02 năm, kể từ ngày: - a) Người đại diện của chưa thành niên, mất năng lực h';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D132_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 132 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '6', n.article_num = '132', n.content = 'Giao dịch dân sự được xác lập trong trường hợp giao dịch dân sự không tuân thủ quy định về hình thức.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D132_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 132 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '132', n.content = 'Hết thời hiệu quy định tại khoản Điều này mà có yêu cầu tuyên bố giao dịch dân sự vô hiệu thì giao dịch dân sự có hiệu lực. không';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D132_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 132 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '132', n.content = 'Đối với giao dịch dân sự quy định tại Điều 123 và Điều 124 của Bộ luật này thì thời hiệu yêu cầu Tòa án tuyên bố giao dịch dân sự vô hiệu bị hạn chế. không';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D133'}) ON CREATE SET n.name = 'Điều 133: Bảo vệ quyền lợi của người thứ ba ngay tình khi giao dịch dân sự vô hiệu', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '133', n.title = 'Bảo vệ quyền lợi của người thứ ba ngay tình khi giao dịch dân sự vô hiệu', n.citation = 'Điều 133 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D133_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 133 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '133', n.content = '- 1 Trường hợp giao dich dân sự vô hiệu nhung đối tượng của giao dịch là tài sản phải ký đã được chuyển giao cho thứ ba ngay tình thì giao dịch được xác lập, thực hiện với người thứ ba vẫn có hiệu Jực';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D167'}) ON CREATE SET n.name = 'Điều 167: Quyền đòi lại động sản phải đăng ký sở hữu từ người chiếm hữu ngay tình quyền không', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '167', n.title = 'Quyền đòi lại động sản phải đăng ký sở hữu từ người chiếm hữu ngay tình quyền không', n.citation = 'Điều 167 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D133_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 133 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '133', n.content = 'Truờng hợp giao dịch dân sự vô hiệu nhung tài sản đã được ký tai cơ quan nhà nước có thẩm quyền, sau đó chuyển giao một giao dịch dân sự khác cho thứ ba ngay tình và người này căn cứ vào việc ký đó mà';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D133_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 133 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '133', n.content = 'Chủ sở hữu không có quyền đòi lại tài sản tù nguời thứ ba ngay tình, nếu giao dịch dân sự với này không bị vô hiệu theo quy định tại khoản 2 Điều này nhưng có quyền khởi kiện; yêu cầu chủ thể có lỗi d';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D134'}) ON CREATE SET n.name = 'Điều 134: Đại diện', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '134', n.title = 'Đại diện', n.citation = 'Điều 134 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D134_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 134 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '134', n.content = 'Đại diện là việc cá nhân, pháp nhân (sau đây chung là người đại chung là người được đại diện) xác lập, thực hiện giao dịch dân sự. gọi';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D134_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 134 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '134', n.content = 'Cá nhân; pháp nhân có thể xác lập, thực hiện giao dịch dân sự qua đại diện: Cá nhân không được để nguời khác đại diện cho mình nếu pháp luật quy định họ phải tự mình xác lập, thực hiện giao dịch đó. t';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D134_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 134 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '134', n.content = '3 Truờng hợp pháp luật quy định thì người đại diện phải có năng lực pháp luật dân sự, năng lực hành vi dân sự phù hợp với giao dịch dân sự được xác lập, thực hiện.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D135'}) ON CREATE SET n.name = 'Điều 135: Căn cứ xác lập đại diện quyền', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '135', n.title = 'Căn cứ xác lập đại diện quyền', n.citation = 'Điều 135 Bộ luật Dân sự 2015';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D136'}) ON CREATE SET n.name = 'Điều 136: Đai diện theo pháp luật của cá nhân', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '136', n.title = 'Đai diện theo pháp luật của cá nhân', n.citation = 'Điều 136 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D136_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 136 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '136', n.content = '- 1 Cha, mẹ đối với con chua thành niên. - 2 Nguời giám hộ đối với người được hộ. Nguời giám hộ của người có khó khăn trong nhận thức, làm chủ hành vi là đại diện theo pháp luật nếu được Tòa án chỉ đị';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D136_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 136 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '136', n.content = 'Nguời do Tòa án chỉ định trong truờng hợp không xác định được người đại diện quy đinh tại khoản 1 và khoản 2 Điều này. - 4 Người do Tòa án chỉ định đối với nguời bị hạn chế lực hành vi dân sự. năng ##';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D136_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 136 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '136', n.content = 'Nguời do Tòa án chỉ đjnh trong trình tố tụng tại Tòa án. quá <!-- image --> - 2 Một pháp nhân có thể có nhiều người đại diện theo pháp luật và mỗi đại diện có quyền đại diện cho pháp nhân theo quy địn';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D140'}) ON CREATE SET n.name = 'Điều 140: Thời hạn đại diện', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '140', n.title = 'Thời hạn đại diện', n.citation = 'Điều 140 Bộ luật Dân sự 2015';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D138'}) ON CREATE SET n.name = 'Điều 138: Đại diện theo ủy quyền', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '138', n.title = 'Đại diện theo ủy quyền', n.citation = 'Điều 138 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D138_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 138 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '138', n.content = 'Cá nhân; pháp nhân có thể uỷ quyền cho cá nhân, pháp nhân khác xác lập, thực hiện giao dịch dân sự.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D138_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 138 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '138', n.content = '2 Các thành viên hộ gia đình, tổ hợp tác, tổ chức khác không có tư cách pháp nhân có thể thỏa thuận cử cá nhân, pháp nhân khác đại diện theo ủy quyền xác lập, thực hiện giao dịch dân sự liên quan đến';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D138_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 138 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '138', n.content = '3 Người từ đú mười lăm tuổi đến chua đủ mười tám tuổi có thể là đại diện theo uỷ quyền; trừ trường hợp pháp luật quy định giao dịch dân sự phải do nguời từ đủ mười tám tuổi trở lên xác lập; thực hiện.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D139'}) ON CREATE SET n.name = 'Điều 139: Hậu pháp lý của hành vi đại diện quả', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '139', n.title = 'Hậu pháp lý của hành vi đại diện quả', n.citation = 'Điều 139 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D139_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 139 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '139', n.content = 'Giao dich dân sự do người đại diện xác lập, thực hiện với nguời thứ ba phù hợp với phạm vi đại diện làm phát sinh quyền; nghĩa vụ đối với người được đại diện.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D139_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 139 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '139', n.content = 'Người đại diện có quyền xác lập, thực hiện hành vi cần thiết dể đạt được mục đích của việc đại diện.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D139_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 139 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '139', n.content = '3 Truờng đại diện biết hoặc phải biết việc xác lập hành vi đại diện là do bị nhầm lẫn, bị lừa dối, bị đe dọa, cưỡng ép mà vẫn xác lập, thực hiện hành vi thì làm phát sinh quyền, nghĩa vụ đối với được';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D140_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 140 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '140', n.content = 'Thời hạn đại diện được xác định theo văn bản ủy quyền, theo quyết định của cơ quan có thẩm quyền; theo điều lệ của pháp nhân hoặc theo quy đinh của pháp luật.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D140_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 140 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '140', n.content = 'Truờng hợp xác định được thời hạn đại diện theo quy định tại khoản Điều này thì thời hạn đại diện được xác định như sau: không - a) Nếu quyền đại diện được xác định theo giao dịch dân sự cụ thể thì th';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D140_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 140 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '140', n.content = 'Đại diện theo ủy chấm dứt trong trường hợp sau đây: quyền - a) Theo thỏa thuận; - b) Thời hạn ủy đã hết; quyền - c) Công việc được uỷ quyền đã hoàn thành; <!-- image --> - Người được đại diện hoặc ngu';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D140_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 140 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '140', n.content = 'Đại diện theo pháp luật chấm dứt trong truờng hợp sau đây: - Người được đại diện là cá nhân đã thành niên hoặc lực hành vi dân sự đã được khôi phuc; năng - b) Người được đại diện là cá nhân chết; - c)';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D141'}) ON CREATE SET n.name = 'Điều 141: Phạm vi đại diện', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '141', n.title = 'Phạm vi đại diện', n.citation = 'Điều 141 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D141_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 141 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '141', n.content = '- vi đại diện theo căn cứ sau đây: - a) Quyết định của cơ quan có thẩm quyền; - b) Điều lệ của pháp nhân; - c) Nội dung ủy quyền; - d) Quy định khác của pháp luật.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D141_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 141 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '141', n.content = 'Truờng không xác định được cu thể phạm vi đại diện theo quy định tại khoản Điều này thì đại diện theo pháp luật có quyền xác thực hiện mọi giao dịch dân sự vì lợi ích của được đại diện, trừ hợp pháp l';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D141_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 141 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '141', n.content = 'Một cá nhân, pháp nhân có thể đại diện cho nhiều cá nhân hoặc pháp nhân khác nhau nhung không được nhân danh được đại diện để xác thực hiện giao dịch dân sự với chính mình hoặc với bên thứ ba mà mình';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D142'}) ON CREATE SET n.name = 'Điều 142: Hậu của giao djch dân sự do ngưrời có đại diện xác lậps thực hiện quyển quả không', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '142', n.title = 'Hậu của giao djch dân sự do ngưrời có đại diện xác lậps thực hiện quyển quả không', n.citation = 'Điều 142 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D142_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 142 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '142', n.content = '- Giao dịch dân sự do có quyền đại diện xác lập, thực hiện làm phát sinh quyền, các truờng hợp sau đây: người không không nghĩa - a) Người được đại diện đã nhận giao dịch; công- - b) Nguời được đại di';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D142_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 142 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '142', n.content = 'Trường giao dịch dân sự do người có quyền đại diện xác lập, thực hiện làm phát sinh nghĩa vụ đối với người được đại diện thì không có quyền đại diện vẫn phải thực hiện nghĩa vụ đối với đã giao djch vớ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D142_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 142 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '142', n.content = 'Người đã giao dịch với đại diện có qụyền đơn phương chấm dứt thực hiện hoặc huỷ bỏ giao dịch dân sự đối với phần vượt phạm vi đại diện hoặc toàn bộ giao dịch dân sự và yêu cầu bồi thường thiệt hại, tr';
