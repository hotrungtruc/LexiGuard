MERGE (n:Clause {node_id: 'VN_BLDS_2015_D163_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 163 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '163', n.content = 'Truờng hợp thật cần thiết vì lý do phòng, an ninh hoặc vì lợi ích gia, tình trang khẩn cấp, phòng thiên tai, Nhà nước trung mua hoặc trung dụng có bổi thường tài sản của tổ chức, cá nhân theo giá thị';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D165'}) ON CREATE SET n.name = 'Điều 165: Chiếm hữu có căn cứ pháp luật', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '165', n.title = 'Chiếm hữu có căn cứ pháp luật', n.citation = 'Điều 165 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '165', n.content = 'Chiếm hữu có căn cứ pháp luật là việc chiếm hũu tài sản trong trường';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '165', n.content = 'hợp sau đây: - a) Chủ sở hữu chiếm hữu tài sản; - b) Người được chủ sở hữu ủy quyền quản lý tài sản;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '5', n.article_num = '165', n.content = 'Người được chuyển giao quyền chiếm hữu qua giao dịch dân sự phù với quy định của pháp luật; thông hợp';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '6', n.article_num = '165', n.content = 'Nguời hiện và giữ tài sản vô chủ, tài sản không xác định được ai là chủ sở hũu, tài sản bị đánh rơi, bị bỏ quên, bị chôn; giấu, bị vùi lấp, chìm đắm phù hợp với điều kiện theo quy định của Bộ luật này';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K07'}) ON CREATE SET n.name = 'Khoản 7 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '7', n.article_num = '165', n.content = 'Nguời phát hiện và giữ gia súc, gia vật nuôi dưới nước bị thất lạc hợp với điều kiện theo quy định của Bộ luật này, quy định khác của pháp luật có liên quan; cầm, phù';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K08'}) ON CREATE SET n.name = 'Khoản 8 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '8', n.article_num = '165', n.content = 'Truờng hợp khác do pháp luật quy định.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D165_K09'}) ON CREATE SET n.name = 'Khoản 9 Điều 165 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '9', n.article_num = '165', n.content = 'Việc chiếm hữu tài sản phù hợp với quy định tại khoản Điều này là chiếm hữu có căn cứ pháp luật. không không';
