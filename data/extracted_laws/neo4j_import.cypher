MERGE (n:Clause {node_id: 'VN_BLLD_2019_D073_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 73 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '2', n.article_num = '73', n.content = 'Xây dựng và cung cấp các tin, dữ liệu về kinh tế - xã hộị, thị trường lao động, quan hệ lao động nhằm hỗ trợ, thúc đẩy thuong luợng tập thễ. thông';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D073_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 73 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '5', n.article_num = '73', n.content = 'Thỏa ước lao tập thể phải gửi cho mỗi bên ký kết và cho cơ quan chuyên môn về lao động thuộc Ủy ban nhân dân cấp tỉnh theo quy định tại Điều 77 của Bộ luật này. được động';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D077'}) ON CREATE SET n.name = 'Điều 77: Gửi thỏa ước lao động tập thể', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '77', n.title = 'Gửi thỏa ước lao động tập thể', n.citation = 'Điều 77 Bộ luật Lao động 2019';
