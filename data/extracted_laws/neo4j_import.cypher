MERGE (n:Clause {node_id: 'VN_BLLD_2019_D218_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 218 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '218', n.content = 'Lao động nữ là cán bộ, công chức cấp xã hoặc là người hoạt động không - hợp đặc biệt theo quy định của Chính truờng phủ:\' - b) Sửa đổi, bổ sung Điều 55 như sau:';
