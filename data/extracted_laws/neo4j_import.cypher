MERGE (n:Article {node_id: 'VN_BLDS_2015_D057'}) ON CREATE SET n.name = 'Điều 57: Nghĩa vụ của người giám hộ đối với người được hộ mất Iực hành vi dân sự, ngưòi có khó khăn trong nhận thức, làm chủ hành vi giám', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '57', n.title = 'Nghĩa vụ của người giám hộ đối với người được hộ mất Iực hành vi dân sự, ngưòi có khó khăn trong nhận thức, làm chủ hành vi giám', n.citation = 'Điều 57 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D057_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 57 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '57', n.content = '- Nguời giám hộ của nguời mất năng lực hành vi dân sự có các nghĩa vụ sau đây: - hộ; giám - b) Đại diện cho người được giám hộ trong các giao dịch dân sự; - c) Quản lý tài sản của người được hộ; giám';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D057_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 57 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '57', n.content = 'Nguời giám hộ của người có khó khăn nhận thức, làm chủ hành vi có nghĩa vụ theo quyết định của Tòa án trong số các nghĩa vụ quy định tại khoản 1 Điều này. trong';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D058'}) ON CREATE SET n.name = 'Điều 58: Quyền của người giám hộ', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '58', n.title = 'Quyền của người giám hộ', n.citation = 'Điều 58 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D058_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 58 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '58', n.content = 'Người giám hộ của chưa thành niên, mất năng lực hành vi';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D058_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 58 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '58', n.content = 'dân sự có các quyền sau đây: nguời nguười - a) Sử dụng tài sản của người được giám hộ để chăm sóc, chi cho nhu cầu thiết yếu của nguời được giám hộ; dùng những - b) Được thanh toán các chi phí hợp lý';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D059'}) ON CREATE SET n.name = 'Điều 59: Quản lý tài sản của người được giám hộ', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '59', n.title = 'Quản lý tài sản của người được giám hộ', n.citation = 'Điều 59 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D059_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 59 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '59', n.content = 'Người giám hộ của nguời chua thành niên; nguời mất lực hành vi dân sự có trách nhiệm quản lý tài sản của nguời được giám hộ như tài sản của chính mình; đuợc thực hiện giao dịch dân sự liên quan đến tà';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D059_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 59 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '59', n.content = 'Nguời giám hộ của có khó khăn trong nhận thức, làm chủ hành vi được lý tài sản của được hộ theo quyết định của Tòa án trong phạm vi được quy định tại khoản 1 Điều này người người giám quản';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D060'}) ON CREATE SET n.name = 'Điều 60: Thay đổi người giám hộ', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '60', n.title = 'Thay đổi người giám hộ', n.citation = 'Điều 60 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D060_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 60 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '60', n.content = 'Nguời giám hộ đuợc thay đổi trong truờng hợp sau đây: - a) Người giám hộ không còn đủ các điều kiện quy định tại Điều 49, Điều 50 của Bộ luật này; - b) Người giám hộ là cá nhân chết hoặc bị Tòa án tuy';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D060_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 60 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '6', n.article_num = '60', n.content = '2 hợp thay đổi nguời hộ nhiên thì được quy định tại Điều 52 và Điều 53 của Bộ luật này là nguời giám hộ nhiên; nêu có nguời giám hộ đuơng nhiên thì việc cử, chỉ định giám hộ được thực hiện theo quy đị';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D060_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 60 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '60', n.content = 'Thủ tục thay đổi người giám hộ được thực hiện theo quy định của pháp luật về hộ tịch.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D061'}) ON CREATE SET n.name = 'Điều 61: Chuyển giao giám hộ', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '61', n.title = 'Chuyển giao giám hộ', n.citation = 'Điều 61 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D061_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 61 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '61', n.content = '- 1 Khi đổi nguời hộ thì trong thời hạn 15 ngày kề từ ngày có giám hộ mới, người đã thực hiện việc giám hộ phải chuyển giao giám hộ cho thế mình. giám thay người người thay';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D061_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 61 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '61', n.content = 'Việc chuyển giao giám hộ phải được lập thành văn bản, trong đó ghi rõ lý do chuyến giao và tình trang tài sản, vấn đề khác có liên quan của được hộ tại thời điểm chuyển giao. Cơ quan cử, chỉ định ngườ';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D062'}) ON CREATE SET n.name = 'Điều 62: Chấm dứt việc hộ giám', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '62', n.title = 'Chấm dứt việc hộ giám', n.citation = 'Điều 62 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D062_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 62 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '62', n.content = 'Việc giám hộ chấm dứt trong trường hợp sau đây: - a) Người được giám hộ đã có năng lục hành vi dân sự đầy đủ; - b) Người được giám hộ chết;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D062_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 62 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '62', n.content = 'Cha, mẹ của người được giám hộ là nguời chưa thành niên đã có đủ điều kiện để thực hiện quyền, nghĩa vụ của mình; - d) Người được giám hộ được nhận làm con nuôi.';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D062_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 62 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '62', n.content = '2 Thủ tục chấm dứt việc giám hộ thực hiện theo quy định của pháp luật về hộ tịch.';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D063'}) ON CREATE SET n.name = 'Điều 63: Hậu chấm dứt việc giám hộ quả', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '63', n.title = 'Hậu chấm dứt việc giám hộ quả', n.citation = 'Điều 63 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D063_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 63 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '63', n.content = 'Irường hợp được giám hộ đã có năng lực hành vi dân sự đầy đủ thì thời hạn 15 ngày kể từ ngày chấm dứt yiệc giám hộ, người hộ thanh toán tài sản với sinh từ giao dịch dân sự vì lợi ích của được giám hộ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D063_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 63 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '63', n.content = '2 Trựờng được hộ chết thì trong thời hạn 03 kể tù chấm dứt việc giám hộ, người giám hộ thanh toán tài sản với thừa quản lý di sản của người được giám hộ, chuyển giao quyền, nghĩa vụ phát sinh từ giao';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D063_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 63 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '63', n.content = 'Trường hợp chấm dứt việc hộ quy định tại điểm c và điểm d khoản 1 Điều 62 của Bộ luật này thì trong thời hạn 15 ngày; kể từ ngày chấm dứt việc giám hộ, giám hộ thanh toán tài sản và chuyển giao quyên;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D063_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 63 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '63', n.content = '4 Việc thanh toán tài sản và chuyển giao quyền; nghĩa vụ quy định tại Điều này được lập thành văn bản với sự giám sát của giám sát việc giám hộ. người';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D064'}) ON CREATE SET n.name = 'Điều 64: Yêu cầu thông báo tìm kiếm người mặt tại nơi cư trú và quản lý tài sản của đó vắng người', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '64', n.title = 'Yêu cầu thông báo tìm kiếm người mặt tại nơi cư trú và quản lý tài sản của đó vắng người', n.citation = 'Điều 64 Bộ luật Dân sự 2015';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D065'}) ON CREATE SET n.name = 'Điều 65: Quản lý tài sản của vắng mặt tại nơi cư trú người', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '65', n.title = 'Quản lý tài sản của vắng mặt tại nơi cư trú người', n.citation = 'Điều 65 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D065_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 65 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '65', n.content = 'Theo yêu cầu của nguời có quyền; lợi ích liên quan; Tòa án giao tài sản của người mặt tại nơi cu trú cho sau đây quản lý: người - a) Đối với tài sản đã đuợc vắng mặt uỷ quyền quản lý thì nguời được uỷ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D065_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 65 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '65', n.content = 'Đối với tài sản do vợ hoặc dang quản lý thì vợ hoặc chồng tiếp tục lý; nếu vợ hoặc chồng chết hoặc mẩt trong nhận thức, làm chủ hành vi, bị hạn chế năng lực hành vi dân sự thì con thành niên hoặc cha,';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D065_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 65 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '65', n.content = '2 Trường hợp có những được quy định tại khoản 1 Điều này thì Tòa án chỉ định một người trong số những thân thích của mặt tại nơi cư trú quản lý tài sản; nếu không có người thân thích thì Tòa án chỉ đị';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D066'}) ON CREATE SET n.name = 'Điều 66: Nghĩa vụ của quản lý tài sản của mặt tại nơi cưr trú vắng người người', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '66', n.title = 'Nghĩa vụ của quản lý tài sản của mặt tại nơi cưr trú vắng người người', n.citation = 'Điều 66 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D066_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 66 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '66', n.content = 'Giữ gìn, bào quản tài sản của người mặt nhu tài sản của chính mình. vắng';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D066_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 66 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '66', n.content = '3 Thực hiện nghĩa vụ cấp dưỡng, thanh toán nợ đến hạn, chính khác của mặt tài sản của đó theo quyết định của Tòa án. nghĩa bằng người vắng người';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D066_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 66 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '4', n.article_num = '66', n.content = 'Giao lại tài sản cho mặt khi người này trở về và phải báo cho Tòa án biết; nếu có phải bồi thường: vắng\_ thông';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D067'}) ON CREATE SET n.name = 'Điều 67: Quyền của người quản lý tài sản của mặt tại nơi cư trú vắng người', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '67', n.title = 'Quyền của người quản lý tài sản của mặt tại nơi cư trú vắng người', n.citation = 'Điều 67 Bộ luật Dân sự 2015';
