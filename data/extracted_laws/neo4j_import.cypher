MERGE (n:Clause {node_id: 'VN_BLDS_2015_D214_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 214 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '214', n.content = 'Chủ sở hữu các căn hộ trong nhà chung cu có quyền, nghĩa vụ ngang nhau trong việc lý, sử dụng tàỉ sản quy định tại khoản Điều này, trừ truờng hợp luật có quy định khác hoặc có thóa thuận khác. quản';
