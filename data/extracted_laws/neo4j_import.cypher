MERGE (n:Article {node_id: 'VN_BLDS_2015_D009'}) ON CREATE SET n.name = 'Điều 9: Thực hiện quyền dân sự', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '9', n.title = 'Thực hiện quyền dân sự', n.citation = 'Điều 9 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D009_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 9 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '9', n.content = 'Cá nhân, pháp nhân thực hiện dân sự theo ý chí của mình, được trái với quy định tại Điều 3 và Điều 10 của Bộ luật này. quyền không';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D009_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 9 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '9', n.content = 'Việc cá nhân, pháp nhân không thực hiện quyền dân sự của mình phải là căn cứ làm chấm dứt quyền; trừ trường hợp luật có quy định khác. không';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D010'}) ON CREATE SET n.name = 'Điều 10: Giới hạn việc thực hỉện quyền dân sự', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '10', n.title = 'Giới hạn việc thực hỉện quyền dân sự', n.citation = 'Điều 10 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D010_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 10 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '10', n.content = 'Cá nhân, pháp nhân được lạm dụng quyền dân sự của mình gây thiệt hại cho nguời khác, đế vi phạm vụ của mình hoặc thực hiện muc đích khác trái pháp luật. không nghĩa';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D010_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 10 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '10', n.content = '2 Truờng hợp cá nhân; pháp nhân không tuân thủ quy định tại khoản 1 Điều này thì Tòa án hoặc cơ quan có thẩm quyền khác căn cứ vào tính chất, hậu của hành vi vi phạm mà có thể bảo vệ một phần hoặc toà';
MERGE (n:Article {node_id: 'VN_BLDS_2015_D011'}) ON CREATE SET n.name = 'Điều 11: Các phương thức bảo vệ quyền dân sự', n.law_id = 'bo-luat-dan-su-2015', n.article_num = '11', n.title = 'Các phương thức bảo vệ quyền dân sự', n.citation = 'Điều 11 Bộ luật Dân sự 2015';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D011_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 11 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '1', n.article_num = '11', n.content = 'Khi quyền dân sự của cá nhân, pháp nhân bị xâm phạm thì chủ thể đó có tự bảo vệ theo quy định của Bộ luật này, luật khác có liên quan hoặc yêu cầu cơ quan, tổ chức có thẩm quyền quyền: - nhận, tôn trọ';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D011_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 11 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '11', n.content = 'Buộc chấm dứt hành vi xâm phạm;';
MERGE (n:Clause {node_id: 'VN_BLDS_2015_D011_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 11 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '3', n.article_num = '11', n.content = 'Buộc xin lỗi, cải chính khai; công - vụ; nghĩa - 4 Buộc thực hiện';
