MERGE (n:Clause {node_id: 'VN_BLLD_2019_D118_K12'}) ON CREATE SET n.name = 'Khoản 12 Điều 118 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '12', n.article_num = '118', n.content = '3, Truớc khi ban hành nội quy lao hoặc sửa đổi, bổ sung nội quy lao người sử dụng lao động phải tham khảo ý kiến của tố chức đại diện lao động tại cơ sở đối với nơi có tổ chức đại diện tại cơ sở. động';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D118_K13'}) ON CREATE SET n.name = 'Khoản 13 Điều 118 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '13', n.article_num = '118', n.content = '4, Nội quy lao động phải được báo đến người lao và nội dung chính phải được niêm yết ở nơi cần thiết tại nơi làm việc. thông dộng những những';
MERGE (n:Article {node_id: 'VN_BLLD_2019_D119'}) ON CREATE SET n.name = 'Điều 119: ký nội quy lao động Đăng', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '119', n.title = 'ký nội quy lao động Đăng', n.citation = 'Điều 119 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D119_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 119 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '119', n.content = 'Người sử dung lao sử dụng từ 10 nguời lao động trở lên phải ký nội quy lao động tại cơ quan chuyên môn về lao thuộc Ủy ban nhân dân cấp tỉnh nơi người sử dụng lao động ký kinh doanh động đăng động đăn';
