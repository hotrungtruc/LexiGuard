MERGE (n:Clause {node_id: 'VN_BLLD_2019_D091_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 91 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '91', n.content = 'Nguời lao động sau giờ, ngày, tuần làm việc hoặc được trả gộp do hai bên thỏa thuận nhung 15 ngày phải đuợc trả gộp một lần hưởng luơng không quá';
