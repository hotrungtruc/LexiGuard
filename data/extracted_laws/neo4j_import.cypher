MERGE (n:Clause {node_id: 'VN_BLDS_2015_D162_K02'}) ON CREATE SET n.name = 'Khoản 2 Điều 162 Bộ luật Dân sự 2015', n.law_id = 'bo-luat-dan-su-2015', n.clause_num = '2', n.article_num = '162', n.content = 'Chủ thể có quyền khác đối với tài sản phải chịu rủi ro về tài sản trong sản hoặc Bộ luật này, luật khác có liên quan quy đinh khác.';
