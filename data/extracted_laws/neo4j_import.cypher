MERGE (n:Article {node_id: 'VN_BLLD_2019_D122'}) ON CREATE SET n.name = 'Điều 122: Nguyên tắc, trình tự, thủ tục xử lý kỷ luật lao động', n.law_id = 'bo-luat-lao-dong-2019', n.article_num = '122', n.title = 'Nguyên tắc, trình tự, thủ tục xử lý kỷ luật lao động', n.citation = 'Điều 122 Bộ luật Lao động 2019';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D122_K01'}) ON CREATE SET n.name = 'Khoản 1 Điều 122 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '1', n.article_num = '122', n.content = 'Việc xử lý kỷ luật lao động được quy định như sau: - a) Nguời sử dung lao động phải chứng minh được lỗi của nguời lao động; - b) Phải có sự tham gia của tổ chức đại diện lao động tại cơ sở mà lao động';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D122_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 122 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '122', n.content = 'tổ chức đại diện nguời lao động bào chữa; truờng hợp là người chua đủ 15 tuổi thì phải có sự tham gia của đại diện theo pháp luật; người - d) Việc xử lý kỷ luật lao động được ghi thành biên bản. phải';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D122_K06'}) ON CREATE SET n.name = 'Khoản 6 Điều 122 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '6', n.article_num = '122', n.content = '2 Không được áp dụng nhiều hình thức xử lý kỷ luật lao động đối với một';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D122_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 122 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '122', n.content = 'Khi một lao đồng thời có nhiều hành vi vi phạm kỷ luật lao động thì chỉ áp dụng hình thức kỷ luật cao nhất tuơng với hành vi vi phạm nhất. nguời động úng nặng';
