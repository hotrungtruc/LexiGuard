MERGE (n:Clause {node_id: 'VN_BLLD_2019_D119_K03'}) ON CREATE SET n.name = 'Khoản 3 Điều 119 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '3', n.article_num = '119', n.content = '3 thời han 07 ngày làm việc kể từ ngày nhận được hồ sơ đăng ký nội quy lao động, nếu nội nội quy lao động có quy đnh trái với pháp luật thì cơ quan chuyên môn về lao động thuuộc ban nhân dân cấp tỉnh';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D119_K04'}) ON CREATE SET n.name = 'Khoản 4 Điều 119 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '4', n.article_num = '119', n.content = 'Người sử dụng lao động có các chi nhánh; đơn vị; cơ sở sản xuất; kinh <!-- image --> đến cơ quan chuyên môn về lao động thuộc Ủy ban nhân dân cấp tỉnh nơi đặt chi nhánh, đơn vị, cơ sở sản xuất, kinh d';
MERGE (n:Clause {node_id: 'VN_BLLD_2019_D119_K05'}) ON CREATE SET n.name = 'Khoản 5 Điều 119 Bộ luật Lao động 2019', n.law_id = 'bo-luat-lao-dong-2019', n.clause_num = '5', n.article_num = '119', n.content = 'Căn cứ điều kiện cụ thể, cơ quan chuyên môn về lao động thuộc Ủy ban nhân dân cấp tỉnh có thể ủy quyền cho cơ quan chuyên môn về lao động thuộc Ủy ban nhân dân cấp huyện thục hiện việc ký nội quy lao';
