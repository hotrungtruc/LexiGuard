# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Providers (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=legal_statutes_corpus

# Neo4j Legal Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=lexiguard_secure_password

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Embeddings & Reranking
DENSE_EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# OCR Quality Assessment Gate Thresholds (Phase 1 vs Phase 2 Branching)
OCR_QUALITY_MIN_BLUR=30.0
OCR_QUALITY_MIN_CONTRAST=20.0
OCR_QUALITY_MIN_WIDTH=500
OCR_QUALITY_MIN_HEIGHT=600

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000

